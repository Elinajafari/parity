{
  "name": "parity",
  "private": true,
  "version": "1.0.0",
  "description": "Parity: translations certified pair by pair on GenLayer. Numbers counted by code, meaning read by validators.",
  "type": "module",
  "license": "MIT",
  "author": "Elina (https://github.com/Elinajafari)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Elinajafari/parity"
  },
  "scripts": {
    "test": "pnpm -r --sequential test",
    "test:contract": "pnpm --filter @parity/contracts test",
    "test:shared": "pnpm --filter @parity/shared test",
    "typecheck": "pnpm --filter @parity/shared typecheck",
    "mutate:contract": "pnpm --filter @parity/contracts mutate",
    "measure:contract": "pnpm --filter @parity/contracts measure",
    "lint:genvm": "node packages/contracts/scripts/lint.mjs",
    "deploy:contract": "node packages/contracts/scripts/deploy.mjs",
    "seed:contract": "node packages/contracts/scripts/seed.mjs",
    "seed:activity": "node packages/contracts/scripts/seed-activity.mjs",
    "e2e:contract": "node packages/contracts/scripts/e2e.mjs",
    "verify:contract": "node packages/contracts/scripts/verify.mjs",
    "evidence:contract": "node packages/contracts/scripts/evidence.mjs",
    "evidence:activity": "node packages/contracts/scripts/evidence.mjs packages/contracts/deployments/studionet-activity.json EVIDENCE-ACTIVITY.md \"Parity, second round\"",
    "demo:contract": "pnpm deploy:contract && pnpm seed:contract && pnpm e2e:contract && pnpm evidence:contract"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.2"
}
